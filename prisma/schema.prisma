generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Sprint 1: User + the tables required by Auth.js's PrismaAdapter
// (https://authjs.dev/getting-started/adapters/prisma).
// Sprint 2: Task + TaskOccurrence (one occurrence per task until recurrence
// generation lands in Sprint 5). Sprint 6: Notification.

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?

  timezone            String    @default("UTC")
  timezoneConfirmedAt DateTime?

  // Sprint 12 (sprint-12-tasks.md S12-09): when free time may be suggested
  // — the searchable day and, on work days, the hours kept for work. Minutes
  // since local midnight in `timezone`; workDays are ISO weekdays
  // (1 = Monday), and none means no work hours at all.
  dayStartMinutes  Int   @default(480)
  dayEndMinutes    Int   @default(1260)
  workDays         Int[] @default([1, 2, 3, 4, 5])
  workStartMinutes Int   @default(540)
  workEndMinutes   Int   @default(1020)
  // The latest a workout may start; null = no limit. Per user, like the
  // hours above ("Расхождения" п.12).
  workoutLatestStartMinutes Int? @default(1200)

  // Sprint 14 (sprint-14-tasks.md S14-06): what a new task's reminder starts
  // at (one of the form's choices, minutes before the start), and whether
  // reminders are emailed at all — Telegram and the in-app toast don't
  // depend on it.
  defaultReminderMinutes Int     @default(15)
  emailRemindersEnabled  Boolean @default(true)

  // Sprint 10: Telegram as a second notification channel. telegramChatId is
  // set once the one-time link code below is redeemed by the webhook; the
  // code/expiry pair is cleared on redemption (or overwritten by generating
  // a new one) — at most one pending code per user, not a separate table.
  telegramChatId            String?   @unique
  telegramLinkCode          String?   @unique
  telegramLinkCodeExpiresAt DateTime?

  // Sprint 15 (sprint-15-tasks.md S15-10): the morning summary in Telegram.
  // Minutes after the user's midnight it's sent at, null = off (the
  // default); sentOn is the user's local "YYYY-MM-DD" it last went out, so
  // a second cron run that day doesn't send it again.
  telegramSummaryMinutes Int?
  telegramSummarySentOn  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  tasks         Task[]
  occurrences   TaskOccurrence[]
  notifications Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Task {
  id     String @id @default(cuid())
  userId String

  title       String
  description String?

  priority    Priority    @default(NORMAL)
  flexibility Flexibility @default(FLEXIBLE)

  durationMinutes Int @default(0)

  // Sprint 2 stores the field so the schema doesn't need a second migration
  // in Sprint 5, but nothing parses or generates occurrences from it yet —
  // the "Repeat" form field is a disabled placeholder until then.
  recurrenceRule String?
  active         Boolean @default(true)

  // 0 = "at time of task" (Sprint 6). Shared by every occurrence of this
  // task, same as durationMinutes/priority.
  reminderOffsetMinutes Int @default(0)

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurrences TaskOccurrence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TaskOccurrence {
  id String @id @default(cuid())

  taskId String
  userId String

  scheduledStart DateTime
  scheduledEnd   DateTime?

  status OccurrenceStatus @default(SCHEDULED)

  snoozeCount Int       @default(0)
  completedAt DateTime?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, scheduledStart])
}

model Notification {
  id           String @id @default(cuid())
  occurrenceId String
  userId       String

  sendAt DateTime
  status NotificationStatus @default(PENDING)

  attemptCount Int       @default(0)
  sentAt       DateTime?

  occurrence TaskOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, sendAt])
}

enum Priority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum Flexibility {
  FIXED
  FLEXIBLE
}

enum OccurrenceStatus {
  SCHEDULED
  DONE
  PARTIALLY_DONE
  SKIPPED
  SNOOZED
  CANCELLED
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}
