generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Sprint 1: User + the tables required by Auth.js's PrismaAdapter
// (https://authjs.dev/getting-started/adapters/prisma).
// Sprint 2: Task + TaskOccurrence (one occurrence per task until recurrence
// generation lands in Sprint 5). Sprint 6: Notification.

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?

  timezone            String    @default("UTC")
  timezoneConfirmedAt DateTime?

  // When the first-run setup (/onboarding: name and timezone, the day,
  // how to add tasks) was finished or skipped; null — not yet, and the app
  // sends the user there. Everyone signed up before it got the migration's
  // time.
  onboardedAt DateTime?

  // Sprint 12 (sprint-12-tasks.md S12-09): when free time may be suggested
  // — the searchable day and, on work days, the hours kept for work. Minutes
  // since local midnight in `timezone`; workDays are ISO weekdays
  // (1 = Monday), and none means no work hours at all.
  dayStartMinutes           Int   @default(480)
  dayEndMinutes             Int   @default(1260)
  workDays                  Int[] @default([1, 2, 3, 4, 5])
  workStartMinutes          Int   @default(540)
  workEndMinutes            Int   @default(1020)
  // The latest a workout may start; null = no limit. Per user, like the
  // hours above ("Расхождения" п.12).
  workoutLatestStartMinutes Int?  @default(1200)

  // Sprint 14 (sprint-14-tasks.md S14-06): what a new task's reminder starts
  // at (one of the form's choices, minutes before the start), and whether
  // reminders are emailed at all — Telegram and the in-app toast don't
  // depend on it.
  defaultReminderMinutes Int     @default(15)
  emailRemindersEnabled  Boolean @default(true)

  // Sprint 10: Telegram as a second notification channel. telegramChatId is
  // set once the one-time link code below is redeemed by the webhook; the
  // code/expiry pair is cleared on redemption (or overwritten by generating
  // a new one) — at most one pending code per user, not a separate table.
  telegramChatId            String?   @unique
  telegramLinkCode          String?   @unique
  telegramLinkCodeExpiresAt DateTime?

  // Sprint 15 (sprint-15-tasks.md S15-10): the morning summary in Telegram.
  // Minutes after the user's midnight it's sent at, null = off (the
  // default); sentOn is the user's local "YYYY-MM-DD" it last went out, so
  // a second cron run that day doesn't send it again.
  telegramSummaryMinutes Int?
  telegramSummarySentOn  String?

  // sprint-21-tasks.md п.10 — the evening "habits left today" message in
  // Telegram: minutes after local midnight, null = off (the default); sentOn
  // is the local "YYYY-MM-DD" it last went out, like the summary's.
  habitReminderMinutes Int?
  habitReminderSentOn  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  tasks         Task[]
  occurrences   TaskOccurrence[]
  notifications Notification[]
  habits        Habit[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Task {
  id     String @id @default(cuid())
  userId String

  title       String
  description String?

  priority    Priority    @default(NORMAL)
  flexibility Flexibility @default(FLEXIBLE)

  durationMinutes Int @default(0)

  // Sprint 2 stores the field so the schema doesn't need a second migration
  // in Sprint 5, but nothing parses or generates occurrences from it yet —
  // the "Repeat" form field is a disabled placeholder until then.
  recurrenceRule String?
  active         Boolean @default(true)

  // 0 = "at time of task" (Sprint 6). Shared by every occurrence of this
  // task, same as durationMinutes/priority.
  reminderOffsetMinutes Int @default(0)

  // sprint-18-tasks.md п.1 — false for a task without a time ("Any time"):
  // its occurrences start at local midnight of their day and have no end.
  // On the task, not the occurrence: a series' days are all one kind.
  hasTime Boolean @default(true)

  // п.11 — OFFSET uses reminderOffsetMinutes; MORNING_OF / EVENING_BEFORE
  // are 09:00 that day / 19:00 the day before, local time; NONE — no
  // reminder at all.
  reminderKind ReminderKind @default(OFFSET)

  // sprint-19-tasks.md п.12 — when the series was ended or the task
  // archived (active = false); null while active. Not updatedAt: any later
  // edit would move it. Old inactive tasks got their updatedAt (S19-01).
  endedAt DateTime?

  // sprint-20-tasks.md п.7 — a deadline for a task without a time ("by
  // 12:00"): minutes of its day, local time (720). Not a start — the task
  // stays in "Any time". Null — no deadline; always null with a time.
  dueMinutes Int?

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurrences TaskOccurrence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TaskOccurrence {
  id String @id @default(cuid())

  taskId String
  userId String

  scheduledStart DateTime
  scheduledEnd   DateTime?

  status OccurrenceStatus @default(SCHEDULED)

  snoozeCount Int       @default(0)
  completedAt DateTime?

  // sprint-19-tasks.md п.1–2 — this day of a series was changed on its own:
  // moved ("Only this day") or removed ("Remove this one"). Changes to the
  // series' time, days or duration leave it as it is.
  isException   Boolean   @default(false)
  // п.18 — where a moved day was before its first move ("Only this day"):
  // the series still counts that date as taken. Later moves keep it; null
  // for a day never moved.
  originalStart DateTime?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, scheduledStart])
}

model Notification {
  id           String @id @default(cuid())
  occurrenceId String
  userId       String

  sendAt DateTime
  status NotificationStatus @default(PENDING)

  attemptCount Int       @default(0)
  sentAt       DateTime?

  occurrence TaskOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, sendAt])
}

// sprint-21-tasks.md п.1 — a daily habit: not a task, no time, never
// overdue. CHECK — done or not (target 1); COUNT — a number towards a
// target (2000 ml of water, 10 000 steps), `step` added per tap.
model Habit {
  id     String @id @default(cuid())
  userId String

  title       String
  kind        HabitKind
  target      Int       @default(1)
  // Free text ("glasses", "steps"); "ml" is shown in litres from 1000.
  unit        String?
  step        Int       @default(1)
  // ISO weekdays (1 = Monday) it's on; all seven by default (п.3).
  weekdays    Int[]     @default([1, 2, 3, 4, 5, 6, 7])
  // sprint-21-tasks.md, доработка п.5 — a COUNT goal per weekday, Monday
  // first, 0 = not that day; empty — `target` on every day in `weekdays`.
  dayTargets  Int[]     @default([])
  // Доработка п.2 — what one tap does to a COUNT habit: false adds `step`
  // (water, steps); true sets the day's goal at once (sleep, reading).
  tapSetsGoal Boolean   @default(false)
  // Order on Progress, Home and in Telegram (п.6), lowest first.
  sortOrder   Int       @default(0)
  // п.11 — hidden from Home and Telegram, history kept; null — active.
  archivedAt  DateTime?

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// One row per habit per local day: how much was done that day (1 for a
// CHECK habit marked done). No row — nothing done.
model HabitLog {
  id      String @id @default(cuid())
  habitId String
  // The user's local "YYYY-MM-DD" (ADR-002), like telegramSummarySentOn.
  date    String
  value   Int
  // Доработка п.6 — the day's goal when it was marked, so a later change
  // of goal doesn't rewrite past days; null — rows from before it, which
  // use the habit's goal for that day.
  target  Int?

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([habitId, date])
}

enum HabitKind {
  CHECK
  COUNT
}

enum Priority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum Flexibility {
  FIXED
  FLEXIBLE
}

enum ReminderKind {
  NONE
  OFFSET
  MORNING_OF
  EVENING_BEFORE
  // sprint-20-tasks.md п.8 — reminderOffsetMinutes before the deadline
  // (dueMinutes) of a task without a time.
  BEFORE_DUE
}

enum OccurrenceStatus {
  SCHEDULED
  DONE
  PARTIALLY_DONE
  SKIPPED
  SNOOZED
  CANCELLED
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}
