# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored — never commit real secrets.

# Postgres connection string from your Neon project (Dashboard → Connection Details).
# Use the "pooled" connection string for the app; Prisma migrations also work with it.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Base URL of the app. http://localhost:3000 in development.
AUTH_URL="http://localhost:3000"

# Google OAuth credentials (Google Cloud Console → APIs & Services → Credentials).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (email magic link provider). https://resend.com/api-keys
RESEND_API_KEY=""
# Sender address. The Resend sandbox address onboarding@resend.dev works without
# domain verification, but can only send to your own Resend account email.
EMAIL_FROM="onboarding@resend.dev"

# Shared secret for the Vercel Cron job (vercel.json) that extends recurring
# tasks' occurrence window. Generate with: openssl rand -hex 32
# Local manual call: curl -H "Authorization: Bearer $CRON_SECRET" localhost:3000/api/cron/extend-occurrences
CRON_SECRET=""
