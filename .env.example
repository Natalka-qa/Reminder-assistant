# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored — never commit real secrets.

# Postgres connection string from your Neon project (Dashboard → Connection Details).
# Use the "pooled" connection string for the app; Prisma migrations also work with it.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Base URL of the app. http://localhost:3000 in development.
AUTH_URL="http://localhost:3000"

# Google OAuth credentials (Google Cloud Console → APIs & Services → Credentials).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (email magic link provider). https://resend.com/api-keys
RESEND_API_KEY=""
# Sender address. The Resend sandbox address onboarding@resend.dev works without
# domain verification, but can only send to your own Resend account email.
EMAIL_FROM="onboarding@resend.dev"

# Shared secret for the Vercel Cron job (vercel.json) that extends recurring
# tasks' occurrence window. Generate with: openssl rand -hex 32
# Local manual call: curl -H "Authorization: Bearer $CRON_SECRET" localhost:3000/api/cron/extend-occurrences
CRON_SECRET=""

# Anthropic API key (https://console.anthropic.com/settings/keys), used by
# task-draft.service.ts to power "Fill from text" on /tasks/new. Optional —
# leave blank to disable that button; the rest of the app is unaffected.
# Spends one short Claude Haiku request per click — negligible per-request cost.
ANTHROPIC_API_KEY=""

# Telegram bot for a second reminder-delivery channel (in addition to email).
# All three optional together — leave all blank to disable; the Settings page
# just won't show a "Telegram" section, and the rest of the app is unaffected.
#
# 1. Message @BotFather on Telegram, /newbot, follow the prompts.
# 2. TELEGRAM_BOT_TOKEN — the token @BotFather gives you.
TELEGRAM_BOT_TOKEN=""
# 3. TELEGRAM_BOT_USERNAME — the bot's @username (without the @), used to
#    build the https://t.me/<username>?start=<code> link on /settings.
TELEGRAM_BOT_USERNAME=""
# 4. TELEGRAM_WEBHOOK_SECRET — shared secret Telegram echoes back in the
#    X-Telegram-Bot-Api-Secret-Token header on every webhook call, so
#    /api/telegram/webhook can reject requests that aren't really from
#    Telegram. Generate with: openssl rand -hex 32
# 5. After deploying, register the webhook once (see README for the full
#    setWebhook curl command).
TELEGRAM_WEBHOOK_SECRET=""
